// ============================================================================
// exp6（实践任务6：20 条指令单周期 CPU）的 Chisel 构建文件
//
// ⚠️ 静态交付：本文件与整个 chisel/ 目录未在真实环境中编译验证过。
//    如需运行：./mill chisel.test
//
// 版本：Scala 2.13 + Chisel 3.5.x + ChiselTest 0.6.x（treadle 后端，纯 JVM）。
// 若使用 Mill 0.11.x：把本文件改名为 build.sc、mill-version 改为 0.11.13，内容不变。
// ============================================================================

//| mill-version: 1.0.4
//| mill-jvm-version: 17

package build

import mill._
import scalalib._

object chisel extends ScalaModule {
  def scalaVersion = "2.13.12"

  def ivyDeps = Agg(
    ivy"edu.berkeley.cs::chisel3:3.5.6"
  )

  object test extends ScalaTests with TestModule.ScalaTest {
    def ivyDeps = Agg(
      ivy"edu.berkeley.cs::chiseltest:0.6.2",
      ivy"org.scalatest::scalatest:3.2.19"
    )
  }
}
