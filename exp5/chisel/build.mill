// SPDX-License-Identifier: BSD-3-Clause
// ============================================================================
// exp5（实践任务5：5 条指令单周期 CPU）的 Chisel 构建文件
//
// ⚠️ 本文件与整个 chisel/ 目录一样属于**静态交付**，未在真实环境中编译验证过。
//    如需运行：
//        ./mill chisel.test          # 跑 src/test/scala 下的 ChiselTest
//        ./mill chisel.runMain ...   # 如需自行加一个 main
//
// 版本选择（见 ../CHISEL-CONVENTIONS.md §3）：
//    Scala 2.13 + Chisel 3.5.x + ChiselTest 0.6.x（treadle 后端，纯 JVM，不需要 Verilator）
//    若改用 OSCPU 模板的 Chisel 7.x，请把测试从 chiseltest 换成
//    chisel3.simulator.EphemeralSimulator（ChiselTest 已归档）。
//
// 若使用 Mill 0.11.x：把本文件改名为 build.sc、把 mill-version 改为 0.11.13，内容不变。
// ============================================================================

//| mill-version: 1.0.4
//| mill-jvm-version: 17

package build

import mill._
import scalalib._

object chisel extends ScalaModule {
  def scalaVersion = "2.13.12"

  def ivyDeps = Agg(
    ivy"edu.berkeley.cs::chisel3:3.5.6"
  )

  object test extends ScalaTests with TestModule.ScalaTest {
    def ivyDeps = Agg(
      ivy"edu.berkeley.cs::chiseltest:0.6.2",
      ivy"org.scalatest::scalatest:3.2.19"
    )
  }
}
