//| mill-version: 1.0.4
//| mill-jvm-version: 17

// SPDX-License-Identifier: BSD-3-Clause
// ============================================================================
// exp20（实践任务20：Cache 模块设计）的 Chisel 构建文件
//
// 本实验是**模块级**独立验证环境（不涉及 CPU/SoC），故 chisel/ 下只含：
//   验证环境 CacheTop（对应 cache_top.v + testbench.v）+ 学生模块 Cache + 测试 + 文档。
//
// ⚠️ 静态交付：未在真实环境中编译验证过。如需运行：./mill chisel.test
// 版本：Scala 2.13 + Chisel 3.5.x + ChiselTest 0.6.x（treadle 后端）。
// 若使用 Mill 0.11.x：改名为 build.sc、mill-version 改为 0.11.13，内容不变。
// ============================================================================

package build

import mill._
import scalalib._

object chisel extends ScalaModule {
  // build.mill 与本模块的 src/ 同级；Mill 默认按 <模块名>/ 推断 moduleDir，
  // 故显式上移一级（见 https://mill-build.org/mill/1.0.x/fundamentals/modules.html#_moduledir）
  def moduleDir = super.moduleDir / os.up

  def scalaVersion = "2.13.12"

  def mvnDeps = Seq(
    mvn"edu.berkeley.cs::chisel3:3.5.6"
  )

  // Mill 1.x 用 Task.Sources（旧版 T.sources 在 1.x 已不存在，且沙箱要求显式声明来源）
  def sources = Task.Sources(
    moduleDir / "src" / "main" / "scala"
  )

  object test extends ScalaTests with TestModule.ScalaTest {
    // 与主模块同根（默认会被推断成 <chisel>/<chisel>/test）
    def moduleDir = chisel.moduleDir

    def mvnDeps = Seq(
      mvn"edu.berkeley.cs::chiseltest:0.6.2",
      mvn"org.scalatest::scalatest:3.2.19"
    )

    def sources = Task.Sources(
      moduleDir / "src" / "test" / "scala"
    )
  }
}
